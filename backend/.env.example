# Copy to .env (git-ignored) and adjust. All variables are optional for the
# milestone 1 shell: unset values are reported as "not configured".

# OpenAI-compatible endpoint base (the SGLang tunnel), e.g. an SSH tunnel to the GX10
MODEL_API_BASE=http://127.0.0.1:30000/v1
# Optional Bearer token; leave empty when the endpoint has no auth
MODEL_API_KEY=
# Model ID to record and use for requests
MODEL_ID=qwen3.8-27b
# Human-readable profile label, e.g. "official Qwen3.8-27B NVFP4 + DSpark"
MODEL_PROFILE_LABEL=
# Declared context window for the active profile (in tokens)
MODEL_CONTEXT_WINDOW=131072

# Recognized by later milestones; not read yet
DEFAULT_REASONING_EFFORT=low
DEFAULT_MAX_TOKENS=8192
DATABASE_URL=sqlite:///./data/model-lab.db
