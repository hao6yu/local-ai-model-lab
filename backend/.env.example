# Copy to .env (git-ignored) and adjust. The JSON list keeps endpoint addresses
# on the backend; the browser receives only safe model metadata.

MODEL_PROFILES_JSON=[{"key":"deepseek","api_base":"http://127.0.0.1:30002/v1","model_id":"deepseek-v4-flash-0731","profile_label":"DeepSeek V4 Flash 0731 EXL3 + DSpark","context_window":262144,"default_reasoning_effort":"high","default_max_tokens":32768,"supports_vision":false},{"key":"ornith","api_base":"http://127.0.0.1:30000/v1","model_id":"ornith-1.5-35b-a3b","profile_label":"Ornith 1.5 35B-A3B NVFP4","context_window":262144,"default_reasoning_effort":"medium","default_max_tokens":16384,"supports_vision":true},{"key":"qwen","api_base":"http://127.0.0.1:30001/v1","model_id":"qwen3.8-27b","profile_label":"Community Qwen3.8-27B NVFP4 + DFlash2","context_window":262144,"default_reasoning_effort":"low","default_max_tokens":16384,"supports_vision":true}]
DEFAULT_MODEL_PROFILE=ornith

# Backward-compatible single-endpoint fallback when MODEL_PROFILES_JSON is unset
MODEL_API_BASE=http://127.0.0.1:30000/v1
# Optional Bearer token; leave empty when the endpoint has no auth
MODEL_API_KEY=
# Model ID to record and use for requests
MODEL_ID=ornith-1.5-35b-a3b
# Human-readable profile label
MODEL_PROFILE_LABEL=Ornith 1.5 35B-A3B NVFP4
# Declared context window for the active profile (in tokens)
MODEL_CONTEXT_WINDOW=262144

# Read by the chat playground (milestone 2) to prefill the UI
DEFAULT_REASONING_EFFORT=medium
DEFAULT_MAX_TOKENS=16384
# Max seconds to wait for any upstream response (read by milestone 2)
UPSTREAM_TIMEOUT_SECONDS=3600
DATABASE_URL=sqlite:///./data/model-lab.db
